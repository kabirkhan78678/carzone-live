<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Reset Your Password</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="http://192.168.29.76:8000/images/remit_go_favicon.svg" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

</head>
<style type="text/css">
    * {
        font-family: "Poppins", sans-serif;
    }

    table {
        width: 100%;
    }
</style>

<body style="background-color: #f2f4f6;">
    <div style="height: 100vh;overflow-y: auto;display: flex;">
        <table
            style="max-width: 600px;width:100%;border-radius: 10px;  box-shadow: 4px 16px 25px rgb(0 0 0 / 12%); background-color: #fff;  border-collapse: collapse; margin: auto;height: auto; max-height: 700px; overflow-y: auto;">
            <tr>
                <td style=" padding: 30px;  background-color: #121C35;">
                    <h2 style="color: #fff; margin: 0px; text-align: center;">
                        <img src="<%= typeof image_logo !== 'undefined' ? image_logo : 'cid:carzone-logo@carzone' %>"
                            alt="Car Zone Logo"
                            style="width: 220px; max-width: 220px; height: 100px; max-height: 100px; object-fit: contain; margin-inline:auto; display: block; margin-left:auto;margin-right:auto">
                    </h2>
                </td>
            </tr>
            <tr>
                <td style=" padding-top: 40px;padding-inline:30px">
                    <h1
                        style="font-size: 20px; line-height: 24px;  font-weight: 600; text-align: center; text-decoration: none; color: #000000;">
                        Forgot Your Password?</h1>
                    <p style="text-align: center; color: #555555; font-size: 15px; line-height: 24px;">
                        Need to reset your password? <br> No problem! Just click the button below
                    </p>
                    <div style="text-align: center;margin-top: 40px;">
                        <a href="<%= resetLink %>"
                            style="background-color:#0BD2F1;padding: 10px 15px; border-radius:5px; outline: none;border:1px solid #0BD2F1; color:#fff; text-decoration:none; font-weight: 500;">Click
                            here</a>
                    </div>

                    <div style="padding-top: 30px; text-align: left;">
                        <h4 style="margin-bottom: 5px; font-size: 16px; font-weight: 600; color: #000000;">Cheers,</h4>
                        <p style="margin-top: 0px; font-size: 14px; color: #555555;">Car Zone Team</p>
                    </div>
                </td>
            </tr>

            <tr style="background-color: #121C35;">
                <td style="padding:30px">
                    <p style="margin-bottom:10px; margin-top: 0px; text-align:center; color:#fff; font-size: 14px;">Need More Help?</p>
                    <a href="mailto:<%= typeof support_email !== 'undefined' ? support_email : 'carzonecti@gmail.com' %>"
                        style="color:#fff !important; text-decoration: underline; text-align:center; display: block; font-size: 14px;">We are here
                        to help you
                        out</a>
                </td>
            </tr>
        </table>
    </div>
    </div>
</body>

</html>