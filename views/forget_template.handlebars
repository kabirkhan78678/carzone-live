
<!DOCTYPE HTML
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional //EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
    xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title>{{t.forgot_your_password}}</title>

    <style type="text/css">
        a,
        a[href],
        a:hover,
        a:link,
        a:visited {
            /* This is the link colour */
            text-decoration: none !important;
            color: #0000EE;
        }

        .link {
            text-decoration: underline !important;
        }

        p,
        p:visited {
            /* Fallback paragraph style */
            font-size: 15px;
            line-height: 24px;
            font-family: 'Helvetica', Arial, sans-serif;
            font-weight: 300;
            text-decoration: none;
            color: #000000;
        }

        h1 {
            /* Fallback heading style */
            font-size: 22px;
            line-height: 24px;
            font-family: 'Helvetica', Arial, sans-serif;
            font-weight: normal;
            text-decoration: none;
            color: #000000;
        }

        .ExternalClass p,
        .ExternalClass span,
        .ExternalClass font,
        .ExternalClass td {
            line-height: 100%;
        }

        .ExternalClass {
            width: 100%;
        }
    </style>
</head>

<body
    style="text-align: center; margin: 0; padding-top: 30px; padding-bottom: 10px; padding-left: 0; padding-right: 0; -webkit-text-size-adjust: 100%;background-color: #f2f4f6; color: #000000"
    align="center">
    <div style="text-align: center;">
        <!-- Start container for logo -->
        <table align="center"
            style="text-align: center; vertical-align: top; width: 600px; max-width: 600px; background-color: #ffffff;"
            width="600">
            <tbody>
                <tr>
                    <td style="width: 596px; vertical-align: top; padding-left: 0; padding-right: 0; padding-top: 15px; padding-bottom: 15px;"
                        width="596">

                        <!-- Your logo is here -->
                        <img style="width: 180px; max-width: 180px; height: 85px; max-height: 85px; text-align: center; color: #ffffff; object-fit: contain;"
                            alt="Logo" src="{{#if logo_url}}{{logo_url}}{{else}}cid:carzone-logo@carzone{{/if}}" align="center" width="180" height="85">

                    </td>
                </tr>
            </tbody>
        </table>
        <!-- End container for logo -->
        <!-- Start single column section -->
        <table align="center"
            style="text-align: center; vertical-align: top; width: 600px; max-width: 600px; background-color: #ffffff;"
            width="600">
            <tbody>
                <tr>
                    <td style="width: 596px; vertical-align: top; padding-left: 30px; padding-right: 30px; padding-top: 30px; padding-bottom: 40px;"
                        width="596">

                        <h1
                            style="font-size: 20px; line-height: 24px; font-family: 'Helvetica', Arial, sans-serif; font-weight: 600; text-decoration: none; color: #000000;">
                           {{#if t.forgot_your_password}}{{t.forgot_your_password}}{{else}}Forgot Your Password?{{/if}}

                        </h1>

                        <p
                            style="font-size: 15px; line-height: 24px; margin-bottom: 30px; font-family: 'Helvetica', Arial, sans-serif; font-weight: 400; text-decoration: none; color: #919293;">
                            {{#if t.we_recived}}{{t.we_recived}}{{else}}We received a request to reset your password. Please use the OTP below to proceed:{{/if}}
                        </p>

                        <!-- OTP Display -->
                        <p
                            style="font-size: 18px; font-weight: bold; color: #000000; background-color: #f4f4f4; padding: 10px 15px; border-radius: 5px; display: inline-block;">
                            {{OTP}}
                        </p>

                        <p
                            style="font-size: 15px; line-height: 24px; margin-top: 20px; font-family: 'Helvetica', Arial, sans-serif; font-weight: 400; text-decoration: none; color: #919293;">
                          {{#if t.password_reset}}{{t.password_reset}}{{else}}If you didn't request a password reset, you can safely ignore this email.{{/if}}
                        </p>
                        <div style="padding-top: 30px; text-align: left;">
                            <h4 style="margin-bottom: 5px; font-family: 'Helvetica', Arial, sans-serif; font-size: 16px; font-weight: 600; color: #000000;">{{#if t.cheers}}{{t.cheers}}{{else}}Cheers,{{/if}}</h4>
                            <p style="margin-top: 0px; font-family: 'Helvetica', Arial, sans-serif; font-size: 14px; color: #555555;">{{#if t.team_name}}{{t.team_name}}{{else}}Car Zone Team{{/if}}</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>


        <!-- End single column section -->
        <!-- Start footer -->
        <table align="center"
            style="text-align: center; vertical-align: top; width: 600px; max-width: 600px; background-color: #000000;"
            width="600">
            <tbody>
                <tr>
                    <td style="width: 596px; vertical-align: top; padding-left: 30px; padding-right: 30px; padding-top: 30px; padding-bottom: 30px;"
                        width="596">

                        <p
                            style="margin-bottom:10px; margin-top: 0px; text-align:center; color:#ffffff; font-family: 'Helvetica', Arial, sans-serif; font-size: 14px;">
                            {{#if t.need_help}}{{t.need_help}}{{else}}Need More Help?{{/if}}</p>

                        <a href="mailto:{{#if support_email}}{{support_email}}{{else}}carzonecti@gmail.com{{/if}}"
                            style="color:#ffffff !important; text-decoration: underline; text-align:center; display: block; font-family: 'Helvetica', Arial, sans-serif; font-size: 14px;">{{#if t.help_link}}{{t.help_link}}{{else}}We are here to help you out{{/if}}</a>

                    </td>
                </tr>
            </tbody>
        </table>
        <!-- End footer -->
    </div>

</body>

</html>