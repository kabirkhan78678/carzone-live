<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vehicle Report</title>

    <!-- Bootstrap 5 -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
      rel="stylesheet"
    />

    <!-- FontAwesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <style>
    body {
      background: #f5f7fb;
      font-family: "DM Sans", sans-serif;
    }

    .report-wrapper {
      max-width: 1024px;
      background: #fff;
      border-radius: 14px;
      padding-inline: 45px;
      box-shadow: 0px 6px 25px rgba(0, 0, 0, 0.08);
    }

    .price-text {
      /* font-weight: bold; */
      color: #d50000;
      font-size: 22px;
      margin-bottom: 0px;
      font-weight: 600;
    }

    .main-car-img {
      width: 100%;
      max-width: 960px;
    }

    .thumb-img {
      /* width: 75px; */
      height: 180px;
      border-radius: 8px;
      border: 1px solid #eee;
      object-fit: contain;
      background-color: #e6e6e6;
    }

    .custom-card {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 24px;
      background: #f9fafb;
      height: 100%;
    }

    .card-custom-box {
      padding: 24px;
      border-radius: 8px;
    }
    .card-custom-box-1 {
      border: 1px solid #e5e7eb;

      background-color: #eff6ff;
    }
    .card-custom-box-1 {
      border: 1px solid #e5e7eb;
      background-color: #f0fdf4;
    }
  .spec-item {
    display: grid;
    padding-block: 8px;
    border-bottom: 1px solid #f1f1f1;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
}

    .spec-item p {
      font-size: 14px;
      color: #1a1a1a;
      margin-bottom: 0;
    word-break: break-word;
    }
    .spec-item span {
      font-size: 14px;
      color: #666666;
      word-break: break-word;
    }

    .feature-list div {
      margin-bottom: 10px;
      font-size: 16px;
      color: #1a1a1a;
    }

    .feature-list i {
      color: green;
      margin-right: 6px;
    }

    .leasing-box {
      background: linear-gradient(90deg, #c00000 0%, #b91c1c 100%);

      padding: 30px;
      border-radius: 8px;
    }
    .leasing-box h5 {
      font-weight: 400;
      font-size: 24px;
      color: #fff;
      margin-bottom: 20px;
    }

    .map-box iframe {
      border-radius: 8px;
    }
    .ct_logo img {
      width: 100%;
      max-width: 150px;
    }
    .ct_pdf_header {
      border-bottom: 2px solid #e5e7eb;
      padding-block: 24px;
    }
    .ct_pdf_header h6 {
      font-weight: 400;
      font-size: 18px;
      color: #1a1a1a;
    }

    /*  */
    .car-title {
      font-weight: 400;
      font-size: 16px;
    }
    .price-text-monthly {
      font-size: 16px;
    }

    .custom-card h6 {
      font-weight: 400;
      font-size: 16px;
      color: #1a1a1a;
    }
    .custom-card-subtitle {
      font-size: 16px;
      font-weight: 400;
    }
    .custom-card-rating i {
      color: #f59e0b;
    }
    .ct-text-danger {
      color: #c00000;
    }
    .address-detail div {
      color: #666666;
      font-size: 14px;
      font-weight: 400;
    }
    .opning-hours-cont {
      color: #666666;
      font-size: 12px;
    }

    .opening-hours {
      color: #1a1a1a;
      font-size: 14px;
      border-top: 1px solid #d1d5db;
      padding-block: 15px;
    }
    .ct_fs_20 {
      font-size: 18px;
    }
    .ct_fs_24 {
      font-size: 18px;
    }
    .ct_fs_14 {
      font-size: 14px;
    }
    .ct_fs_12 {
      font-size: 12px;
    }
    .ct_fw_400 {
      font-weight: 400;
    }
    .feature-list {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }
    .waranty-box-content {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .waranty-box-content span {
      color: #666666;
      font-size: 14px;
    }

    .waranty-box-content p {
      color: #1a1a1a;
      font-size: 14px;
      margin-bottom: 0;
    }

    .vehicle-desc-content {
      max-height: 250px;
      overflow-y: auto;
      /* Firefox */
      scrollbar-width: thin;
      scrollbar-color: #c1c9d6 transparent;
      padding-right: 10px;
    }

    /* Chrome, Edge, Safari */
    .vehicle-desc-content::-webkit-scrollbar {
      width: 6px; /* 👈 Thin scrollbar */
    }

    .vehicle-desc-content::-webkit-scrollbar-track {
      background: transparent;
    }

    .vehicle-desc-content::-webkit-scrollbar-thumb {
      background-color: #c1c9d6;
      border-radius: 10px;
    }

    #ct_instructor_setting_variant_1
      .profile-desc::-webkit-scrollbar-thumb:hover {
      background-color: #aab4c3;
    }
    .ct_time_slot_div{
      display: grid;
    align-items: center;
    grid-template-columns: 50px 10px auto;
    }

    @media (max-width: 767px) {
      .thumb-img {
        height: 100px;
      }
      .car-title {
        font-size: 20px;
      }
    }
    @media (max-width: 576px) {
      .thumb-img {
        height: 65px;
      }
      .ct_logo img {
        max-width: 100px;
      }
     
      .report-wrapper {
        padding-inline: 25px;
      }
      .price-text {
        font-size: 20px;
      }
      .price-text-monthly {
        font-size: 16px;
      }
    }
  </style>

  <body>
    <div class="container report-wrapper my-4">
      <!-- ================= HEADER ================= -->
      <div
        class="d-flex justify-content-between align-items-center mb-4 ct_pdf_header"
      >
        <!-- Logo -->
        <div class="ct_logo">
          <img src="{{branding.logoUrl}}" />
        </div>

        <!-- Report Info -->
        <div class="text-end">
          <h6 class="mb-0">Vehicle Details Report</h6>
          <small class="text-muted">Generated: {{generatedAt}}</small>
        </div>
      </div>

      <!-- ================= TITLE + PRICE ================= -->
      <div class="mb-4">
        <h4 class="car-title">
          {{vehicle.brand}} {{vehicle.model}} ({{vehicle.year}})
        </h4>

        <div class="d-flex align-items-end gap-2 mt-2 flex-wrap">
          <h2 class="price-text">{{vehicle.price}}</h2>
          <p class="text-muted mb-0 price-text-monthly">
            Monthly leasing: <b>{{vehicle.perMonthPrice}}</b> per month
          </p>
        </div>
      </div>

      <!-- ================= MAIN IMAGE ================= -->
      <div class="text-center mb-4">
        <img src="{{images.[0]}}" class="main-car-img" style="height: 280px; object-fit: contain; background-color: #f5f5f5;"  />
      </div>

      <!-- ================= THUMBNAILS ================= -->
      <div class="d-flex justify-content-center gap-3 mb-4">
      {{#each images}}
      <img src="{{this}}" class="thumb-img"  style="width:88px; object-fit: contain; height: 88px; background-color: #f5f5f5;" />
      {{/each}}
      </div>

      <!-- ================= DEALER + SPECS ================= -->
      <div class="row g-4 mb-4">
        <!-- Dealer Info -->
        <div class="col-md-4">
          <div class="card custom-card">
            <h6 class="mb-3">
              <svg
                width="15"
                height="28"
                class="me-2"
                viewBox="0 0 15 28"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M15 28H0V0H15V28Z" stroke="#E5E7EB" />
                <g clip-path="url(#clip0_3921_980)">
                  <path
                    d="M1.875 3.5C0.839844 3.5 0 4.33984 0 5.375V21.625C0 22.6602 0.839844 23.5 1.875 23.5H5.625V20.375C5.625 19.3398 6.46484 18.5 7.5 18.5C8.53516 18.5 9.375 19.3398 9.375 20.375V23.5H13.125C14.1602 23.5 15 22.6602 15 21.625V5.375C15 4.33984 14.1602 3.5 13.125 3.5H1.875ZM2.5 12.875C2.5 12.5312 2.78125 12.25 3.125 12.25H4.375C4.71875 12.25 5 12.5312 5 12.875V14.125C5 14.4688 4.71875 14.75 4.375 14.75H3.125C2.78125 14.75 2.5 14.4688 2.5 14.125V12.875ZM6.875 12.25H8.125C8.46875 12.25 8.75 12.5312 8.75 12.875V14.125C8.75 14.4688 8.46875 14.75 8.125 14.75H6.875C6.53125 14.75 6.25 14.4688 6.25 14.125V12.875C6.25 12.5312 6.53125 12.25 6.875 12.25ZM10 12.875C10 12.5312 10.2812 12.25 10.625 12.25H11.875C12.2188 12.25 12.5 12.5312 12.5 12.875V14.125C12.5 14.4688 12.2188 14.75 11.875 14.75H10.625C10.2812 14.75 10 14.4688 10 14.125V12.875ZM3.125 7.25H4.375C4.71875 7.25 5 7.53125 5 7.875V9.125C5 9.46875 4.71875 9.75 4.375 9.75H3.125C2.78125 9.75 2.5 9.46875 2.5 9.125V7.875C2.5 7.53125 2.78125 7.25 3.125 7.25ZM6.25 7.875C6.25 7.53125 6.53125 7.25 6.875 7.25H8.125C8.46875 7.25 8.75 7.53125 8.75 7.875V9.125C8.75 9.46875 8.46875 9.75 8.125 9.75H6.875C6.53125 9.75 6.25 9.46875 6.25 9.125V7.875ZM10.625 7.25H11.875C12.2188 7.25 12.5 7.53125 12.5 7.875V9.125C12.5 9.46875 12.2188 9.75 11.875 9.75H10.625C10.2812 9.75 10 9.46875 10 9.125V7.875C10 7.53125 10.2812 7.25 10.625 7.25Z"
                    fill="#C00000"
                  />
                </g>
                <defs>
                  <clipPath id="clip0_3921_980">
                    <path d="M0 3.5H15V23.5H0V3.5Z" fill="white" />
                  </clipPath>
                </defs>
              </svg>

              Dealer Information
            </h6>

            <p class="custom-card-subtitle mb-1">{{seller.company}}</p>
            <p class="mb-3 custom-card-rating">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              
               {{#if seller.rating}}{{seller.rating}}{{/if}}
            </p>

            <div class="address-detail">
              <div class="mb-2 d-flex gap-3">
                <div>
                  <i class="fa-solid fa-location-dot ct-text-danger"></i>
                </div>
                
                {{#if seller.address}}{{seller.address}}<br />{{/if}}
                {{seller.pincode}} {{seller.city}}
              </div>

              <div class="mb-2 d-flex gap-3">
                <div>
                  <i class="fa-solid fa-phone ct-text-danger"></i>
                </div>
                <div>{{seller.phone}}</div>
              </div>

              <div class="mb-3 d-flex gap-3">
                <div>
                  <i class="fa-solid fa-globe ct-text-danger"></i>
                </div>
                <div>{{seller.website}}</div>
              </div>

              <!-- Opening Hours -->
              <p class="opning-hours-cont mb-0">
             {{#each seller.openingTimes}}
             <div class="ct_time_slot_div">
              
               <span>{{#if dayLabel}}{{dayLabel}}{{else}}{{day}}{{/if}}</span> : <span>{{display}}</span>
             </div> 
             {{/each}}
              </p>

            </div>
          </div>
        </div>

        <!-- Key Specs -->
        <div class="col-md-8">
          <div class="card custom-card p-3">
            <h6 class="">
              <svg
                class="me-2"
                width="20"
                height="28"
                viewBox="0 0 20 28"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M20 28H0V0H20V28Z" stroke="#E5E7EB" />
                <g clip-path="url(#clip0_3921_1040)">
                  <path
                    d="M0 13.5C0 10.8478 1.05357 8.3043 2.92893 6.42893C4.8043 4.55357 7.34784 3.5 10 3.5C12.6522 3.5 15.1957 4.55357 17.0711 6.42893C18.9464 8.3043 20 10.8478 20 13.5C20 16.1522 18.9464 18.6957 17.0711 20.5711C15.1957 22.4464 12.6522 23.5 10 23.5C7.34784 23.5 4.8043 22.4464 2.92893 20.5711C1.05357 18.6957 0 16.1522 0 13.5ZM11.25 7.25C11.25 6.91848 11.1183 6.60054 10.8839 6.36612C10.6495 6.1317 10.3315 6 10 6C9.66848 6 9.35054 6.1317 9.11612 6.36612C8.8817 6.60054 8.75 6.91848 8.75 7.25C8.75 7.58152 8.8817 7.89946 9.11612 8.13388C9.35054 8.3683 9.66848 8.5 10 8.5C10.3315 8.5 10.6495 8.3683 10.8839 8.13388C11.1183 7.89946 11.25 7.58152 11.25 7.25ZM10 19.75C11.3789 19.75 12.5 18.6289 12.5 17.25C12.5 16.5703 12.2305 15.957 11.793 15.5078L14.2969 9.81641C14.5039 9.34375 14.2891 8.78906 13.8164 8.58203C13.3438 8.375 12.7891 8.58984 12.582 9.0625L10.0742 14.75C10.0508 14.75 10.0234 14.75 10 14.75C8.62109 14.75 7.5 15.8711 7.5 17.25C7.5 18.6289 8.62109 19.75 10 19.75ZM6.875 9.125C6.875 8.79348 6.7433 8.47554 6.50888 8.24112C6.27446 8.0067 5.95652 7.875 5.625 7.875C5.29348 7.875 4.97554 8.0067 4.74112 8.24112C4.5067 8.47554 4.375 8.79348 4.375 9.125C4.375 9.45652 4.5067 9.77446 4.74112 10.0089C4.97554 10.2433 5.29348 10.375 5.625 10.375C5.95652 10.375 6.27446 10.2433 6.50888 10.0089C6.7433 9.77446 6.875 9.45652 6.875 9.125ZM3.75 14.75C4.08152 14.75 4.39946 14.6183 4.63388 14.3839C4.8683 14.1495 5 13.8315 5 13.5C5 13.1685 4.8683 12.8505 4.63388 12.6161C4.39946 12.3817 4.08152 12.25 3.75 12.25C3.41848 12.25 3.10054 12.3817 2.86612 12.6161C2.6317 12.8505 2.5 13.1685 2.5 13.5C2.5 13.8315 2.6317 14.1495 2.86612 14.3839C3.10054 14.6183 3.41848 14.75 3.75 14.75ZM17.5 13.5C17.5 13.1685 17.3683 12.8505 17.1339 12.6161C16.8995 12.3817 16.5815 12.25 16.25 12.25C15.9185 12.25 15.6005 12.3817 15.3661 12.6161C15.1317 12.8505 15 13.1685 15 13.5C15 13.8315 15.1317 14.1495 15.3661 14.3839C15.6005 14.6183 15.9185 14.75 16.25 14.75C16.5815 14.75 16.8995 14.6183 17.1339 14.3839C17.3683 14.1495 17.5 13.8315 17.5 13.5Z"
                    fill="#C00000"
                  />
                </g>
                <defs>
                  <clipPath id="clip0_3921_1040">
                    <path d="M0 3.5H20V23.5H0V3.5Z" fill="white" />
                  </clipPath>
                </defs>
              </svg>

              Key Specifications
            </h6>

            <div class="row px-3">
              <div class="col-sm-6 spec-item">
                <span>First Registration</span>
                <p>{{vehicle.firstRegistration}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Body Type</span>
                <p>{{vehicle.bodyType}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Mileage</span>
                <p>{{vehicle.mileage}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Fuel Type</span>
                <p>{{vehicle.fuel}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Transmission</span>
                <p>{{vehicle.transmission}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Power</span>
                <p>{{vehicle.power}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Drive Type</span>
                <p>{{vehicle.driveType}}</p>
              </div>

              <div class="col-sm-6 spec-item">
                <span>Consumption</span>
                <p>{{vehicle.consumption}}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ================= EQUIPMENT ================= -->
      <br><br>
      <div class="mb-4">
        <h6 class="ct_fs_20 ct_fw_400 mb-3">
          <svg
            class="me-2"
            width="20"
            height="28"
            viewBox="0 0 20 28"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
