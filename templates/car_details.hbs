            </g>
            <defs>
              <clipPath id="clip0_3921_1072">
                <path d="M0 3.5H20V23.5H0V3.5Z" fill="white" />
              </clipPath>
            </defs>
          </svg>

          Equipment & Features
        </h6>

        <div class="feature-list">
          {{#if equipment.length}}
          {{#each equipment}}
          <div class=""><i class="fa-solid fa-circle-check"></i> {{this}}</div>
          {{/each}}
          {{else}}
          <div class=""><i class="fa-solid fa-circle-check"></i> N/A</div>
          {{/if}}
        </div>
      </div>

      <!-- ================= DESCRIPTION ================= -->
      <div class="mb-4">
        <h6 class="ct_fs_20 ct_fw_400 mb-2">
          <svg
            width="15"
            height="28"
            class="me-2"
            viewBox="0 0 15 28"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M15 28H0V0H15V28Z" stroke="#E5E7EB" />
