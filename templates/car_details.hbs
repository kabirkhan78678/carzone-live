<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vehicle Report - {{vehicle.brand}} {{vehicle.model}}</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <style>
    @page {
      size: A4 portrait;
      margin: 10mm 12mm 10mm 12mm;
    }

    *, *:before, *:after {
      box-sizing: border-box;
    }

    body {
      background-color: #ffffff;
      color: #1e293b;
      font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 13px;
      line-height: 1.45;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .report-container {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      padding: 0;
    }

    /* Page-break utility */
    .avoid-break {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    /* ================= HEADER ================= */
    .pdf-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 2px solid #e2e8f0;
      margin-bottom: 14px;
    }

    .brand-logo img {
      max-height: 46px;
      max-width: 180px;
      object-fit: contain;
    }

    .header-meta {
      text-align: right;
    }

    .header-title-badge {
      display: inline-block;
      background-color: #f1f5f9;
      color: #0f172a;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 4px 10px;
      border-radius: 6px;
      border: 1px solid #cbd5e1;
    }

    .header-date {
      color: #64748b;
      font-size: 11px;
      margin-top: 4px;
    }

    /* ================= VEHICLE TITLE & HERO ================= */
    .hero-banner {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
      gap: 16px;
      flex-wrap: wrap;
    }

    .vehicle-title-wrap {
      flex: 1;
      min-width: 280px;
    }

    .vehicle-title {
      font-size: 22px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 6px 0;
      line-height: 1.25;
    }

    .vehicle-badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      align-items: center;
    }

    .badge-tag {
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .badge-id {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #cbd5e1;
    }

    .badge-year {
      background: #e0f2fe;
      color: #0369a1;
      border: 1px solid #bae6fd;
    }

    .badge-swiss {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    .badge-quality {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    .price-box {
      text-align: right;
      background: #fff5f5;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 8px 14px;
      min-width: 170px;
    }

    .main-price {
      color: #c00000;
      font-size: 22px;
      font-weight: 800;
      margin: 0;
      line-height: 1.1;
    }

    .monthly-price {
      color: #475569;
      font-size: 11.5px;
      margin: 4px 0 0 0;
      font-weight: 500;
    }

    .monthly-price b {
      color: #0f172a;
    }

    /* ================= IMAGES COLLAGE GALLERY ================= */
    .gallery-container {
      margin-bottom: 16px;
    }

    .collage-grid {
      display: grid;
      gap: 4px;
      background-color: #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #cbd5e1;
      height: 275px;
      width: 100%;
    }

    .collage-item {
      position: relative;
      background-color: #f1f5f9;
      overflow: hidden;
      height: 100%;
      width: 100%;
    }

    .collage-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* 5+ Images: 1 Large Hero Left (58%) + 4 Grid Right (2x2) */
    .collage-5 {
      grid-template-columns: 1.35fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .collage-5 .collage-hero {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }

    /* 4 Images: 1 Large Hero Left + 3 Stacked Right */
    .collage-4 {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: 1fr 1fr 1fr;
    }
    .collage-4 .collage-hero {
      grid-column: 1 / 2;
      grid-row: 1 / 4;
    }

    /* 3 Images: 1 Large Hero Left + 2 Stacked Right */
    .collage-3 {
      grid-template-columns: 1.5fr 1fr;
      grid-template-rows: 1fr 1fr;
    }
    .collage-3 .collage-hero {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }

    /* 2 Images: 50/50 Side by side */
    .collage-2 {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr;
    }

    /* 1 Image: Full featured view without cropping the car */
    .collage-1 {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      height: 290px;
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
    }
    .collage-1 .collage-img {
      object-fit: contain;
      background-color: #f8fafc;
      padding: 4px;
    }

    .collage-empty {
      height: 160px;
      background-color: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #94a3b8;
      gap: 8px;
      font-size: 13px;
    }

    /* ================= TWO COLUMN CONTENT ================= */
    .two-col-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    /* ================= CARDS & BOXES ================= */
    .pdf-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
    }

    .card-header-styled {
      background-color: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      padding: 8px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      font-size: 12.5px;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .card-header-styled i, .card-header-styled svg {
      color: #c00000;
      font-size: 14px;
    }

    .card-body-styled {
      padding: 12px;
    }

    /* Dealer Info Styling */
    .dealer-company-name {
      font-size: 15px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 4px 0;
    }

    .dealer-rating {
      color: #eab308;
      font-size: 11px;
      margin-bottom: 10px;
    }

    .dealer-rating span {
      color: #475569;
      font-weight: 600;
      margin-left: 4px;
    }

    .dealer-contact-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 7px;
      font-size: 11.5px;
      color: #334155;
    }

    .dealer-contact-item i {
      color: #c00000;
      width: 14px;
      margin-top: 2px;
      text-align: center;
      flex-shrink: 0;
    }

    .dealer-contact-item a {
      color: #0284c7;
      text-decoration: none;
    }

    .opening-hours-header {
      font-size: 11px;
      font-weight: 700;
      color: #475569;
      text-transform: uppercase;
      margin: 10px 0 6px 0;
      padding-top: 8px;
      border-top: 1px dashed #e2e8f0;
    }

    .opening-time-row {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      padding: 2px 0;
      color: #475569;
    }

    .opening-time-row .day-name {
      font-weight: 600;
      color: #1e293b;
    }

    .opening-time-row.closed-day .time-val {
      color: #94a3b8;
      font-style: italic;
    }

    /* ================= KEY SPECS GRID ================= */
    .specs-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }

    .spec-item-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 6px 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 42px;
    }

    .spec-item-box .spec-label {
      font-size: 11px;
      color: #64748b;
      font-weight: 500;
    }

    .spec-item-box .spec-value {
      font-size: 12px;
      font-weight: 700;
      color: #0f172a;
      text-align: right;
    }

    /* ================= EQUIPMENT LIST ================= */
    .equipment-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px 12px;
    }

    .equipment-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      color: #1e293b;
    }

    .equipment-item i {
      color: #16a34a;
      font-size: 11px;
      flex-shrink: 0;
    }

    /* ================= DESCRIPTION BOX ================= */
    .description-text {
      font-size: 12px;
      line-height: 1.55;
      color: #334155;
      white-space: pre-line;
      margin: 0;
    }

    /* ================= DUAL MFK & WARRANTY BOXES ================= */
    .dual-cards-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 11.5px;
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      color: #64748b;
      font-weight: 500;
    }

    .info-value {
      color: #0f172a;
      font-weight: 600;
    }

    .status-pill {
      font-size: 10.5px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      display: inline-block;
    }

    .status-pill.valid {
      background: #dcfce7;
      color: #15803d;
    }

    .status-pill.due {
      background: #fef9c3;
      color: #a16207;
    }

    .status-pill.expired {
      background: #fee2e2;
      color: #b91c1c;
    }

    /* ================= LEASING BANNER ================= */
    .leasing-card {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      color: #ffffff;
      border-radius: 8px;
      padding: 14px 16px;
      margin-bottom: 16px;
      border: 1px solid #334155;
    }

    .leasing-header {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #f8fafc;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .leasing-header i {
      color: #ef4444;
    }

    .leasing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px 14px;
    }

    .leasing-item .label {
      font-size: 10.5px;
      color: #94a3b8;
      text-transform: uppercase;
      margin-bottom: 2px;
    }

    .leasing-item .value {
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
    }

    /* ================= FOOTER ================= */
    .pdf-footer {
      border-top: 1px solid #e2e8f0;
      padding-top: 10px;
      margin-top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      color: #64748b;
    }

    .footer-left {
      max-width: 70%;
    }

    .footer-right {
      text-align: right;
    }
  </style>
</head>

<body>
  <div class="report-container">
    <!-- ================= HEADER ================= -->
    <div class="pdf-header">
      <div class="brand-logo">
        <img src="{{branding.logoUrl}}" alt="CarZone" />
      </div>
      <div class="header-meta">
        <div class="header-title-badge">Vehicle Report</div>
        <div class="header-date">Generated: {{generatedAt}}</div>
      </div>
    </div>

    <!-- ================= HERO / TITLE & PRICE ================= -->
    <div class="hero-banner avoid-break">
      <div class="vehicle-title-wrap">
        <h1 class="vehicle-title">{{vehicle.brand}} {{vehicle.model}} {{#if vehicle.year}}({{vehicle.year}}){{/if}}</h1>
        <div class="vehicle-badges">
          {{#if vehicle.id}}<span class="badge-tag badge-id"><i class="fa-solid fa-hashtag"></i> Ref: {{vehicle.id}}</span>{{/if}}
          {{#if vehicle.year}}<span class="badge-tag badge-year"><i class="fa-solid fa-calendar"></i> {{vehicle.year}}</span>{{/if}}
          {{#if warrantyAndReturn.swissCarText}}<span class="badge-tag badge-swiss"><i class="fa-solid fa-plus"></i> Swiss Car</span>{{/if}}
          {{#if warrantyAndReturn.qualityBaseText}}<span class="badge-tag badge-quality"><i class="fa-solid fa-shield-halved"></i> Quality Base</span>{{/if}}
        </div>
      </div>

      <div class="price-box">
        <div class="main-price">
          {{#if vehicle.price}}CHF {{vehicle.price}}{{else}}-{{/if}}
        </div>
        {{#if vehicle.perMonthPrice}}
        <div class="monthly-price">
          Monthly leasing: <b>CHF {{vehicle.perMonthPrice}}</b> / mo
        </div>
        {{/if}}
      </div>
    </div>

    <!-- ================= IMAGE COLLAGE GALLERY ================= -->
    <div class="gallery-container avoid-break">
      {{#if images.[4]}}
      <!-- 5+ Images Collage: 1 Big Hero Left + 4 Grid Right -->
      <div class="collage-grid collage-5">
        <div class="collage-item collage-hero">
          <img src="{{images.[0]}}" class="collage-img" alt="Main Photo" />
        </div>
        <div class="collage-item">
          <img src="{{images.[1]}}" class="collage-img" alt="Photo 2" />
        </div>
        <div class="collage-item">
          <img src="{{images.[2]}}" class="collage-img" alt="Photo 3" />
        </div>
        <div class="collage-item">
          <img src="{{images.[3]}}" class="collage-img" alt="Photo 4" />
        </div>
        <div class="collage-item">
          <img src="{{images.[4]}}" class="collage-img" alt="Photo 5" />
        </div>
      </div>
      {{else if images.[3]}}
      <!-- 4 Images Collage: 1 Big Hero Left + 3 Stacked Right -->
      <div class="collage-grid collage-4">
        <div class="collage-item collage-hero">
          <img src="{{images.[0]}}" class="collage-img" alt="Main Photo" />
        </div>
        <div class="collage-item">
          <img src="{{images.[1]}}" class="collage-img" alt="Photo 2" />
        </div>
        <div class="collage-item">
          <img src="{{images.[2]}}" class="collage-img" alt="Photo 3" />
        </div>
        <div class="collage-item">
          <img src="{{images.[3]}}" class="collage-img" alt="Photo 4" />
        </div>
      </div>
      {{else if images.[2]}}
      <!-- 3 Images Collage: 1 Big Hero Left + 2 Stacked Right -->
      <div class="collage-grid collage-3">
        <div class="collage-item collage-hero">
          <img src="{{images.[0]}}" class="collage-img" alt="Main Photo" />
        </div>
        <div class="collage-item">
          <img src="{{images.[1]}}" class="collage-img" alt="Photo 2" />
        </div>
        <div class="collage-item">
          <img src="{{images.[2]}}" class="collage-img" alt="Photo 3" />
        </div>
      </div>
      {{else if images.[1]}}
      <!-- 2 Images Collage: 2 Columns Side-by-Side -->
      <div class="collage-grid collage-2">
        <div class="collage-item">
          <img src="{{images.[0]}}" class="collage-img" alt="Photo 1" />
        </div>
        <div class="collage-item">
          <img src="{{images.[1]}}" class="collage-img" alt="Photo 2" />
        </div>
      </div>
      {{else if images.[0]}}
      <!-- 1 Single Image Banner -->
      <div class="collage-grid collage-1">
        <div class="collage-item">
          <img src="{{images.[0]}}" class="collage-img" alt="Main Photo" />
        </div>
      </div>
      {{else}}
      <div class="collage-empty">
        <i class="fa-solid fa-car fa-2x"></i>
        <div>No Images Available</div>
      </div>
      {{/if}}
    </div>

    <!-- ================= DEALER INFO & KEY SPECS ================= -->
    <div class="two-col-layout avoid-break">
      <!-- Dealer Info -->
      <div class="pdf-card">
        <div class="card-header-styled">
          <i class="fa-solid fa-building"></i>
          <span>Dealer Information</span>
        </div>
        <div class="card-body-styled">
          <div class="dealer-company-name">{{seller.company}}</div>
          
          {{#if seller.rating}}
          <div class="dealer-rating">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <span>{{seller.rating}} / 5</span>
          </div>
          {{/if}}

          {{#if seller.address}}
          <div class="dealer-contact-item">
            <i class="fa-solid fa-location-dot"></i>
            <div>
              {{seller.address}}<br />
              {{#if seller.pincode}}{{seller.pincode}} {{/if}}{{seller.city}}
            </div>
          </div>
          {{else}}
          <div class="dealer-contact-item">
            <i class="fa-solid fa-location-dot"></i>
            <div>{{#if seller.pincode}}{{seller.pincode}} {{/if}}{{seller.city}}</div>
          </div>
          {{/if}}

          {{#if seller.phone}}
          <div class="dealer-contact-item">
            <i class="fa-solid fa-phone"></i>
            <div>{{seller.phone}}</div>
          </div>
          {{/if}}

          {{#if seller.email}}
          <div class="dealer-contact-item">
            <i class="fa-solid fa-envelope"></i>
            <div>{{seller.email}}</div>
          </div>
          {{/if}}

          {{#if seller.website}}
          <div class="dealer-contact-item">
            <i class="fa-solid fa-globe"></i>
            <div>{{seller.website}}</div>
          </div>
          {{/if}}

          <!-- Opening Hours -->
          {{#if seller.openingTimes.length}}
          <div class="opening-hours-header">Opening Hours</div>
          {{#each seller.openingTimes}}
          <div class="opening-time-row {{#if isClosed}}closed-day{{/if}}">
            <span class="day-name">{{#if dayLabel}}{{dayLabel}}{{else}}{{day}}{{/if}}</span>
            <span class="time-val">{{display}}</span>
          </div>
          {{/each}}
          {{/if}}
        </div>
      </div>

      <!-- Key Specifications -->
      <div class="pdf-card">
        <div class="card-header-styled">
          <i class="fa-solid fa-sliders"></i>
          <span>Key Specifications</span>
        </div>
        <div class="card-body-styled">
          <div class="specs-grid">
            <div class="spec-item-box">
              <span class="spec-label">First Reg.</span>
              <span class="spec-value">{{vehicle.firstRegistration}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Mileage</span>
              <span class="spec-value">{{vehicle.mileage}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Fuel Type</span>
              <span class="spec-value">{{vehicle.fuel}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Transmission</span>
              <span class="spec-value">{{vehicle.transmission}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Power</span>
              <span class="spec-value">{{vehicle.power}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Drive Type</span>
              <span class="spec-value">{{vehicle.driveType}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Body Type</span>
              <span class="spec-value">{{vehicle.bodyType}}</span>
            </div>
            <div class="spec-item-box">
              <span class="spec-label">Consumption</span>
              <span class="spec-value">{{vehicle.consumption}}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= EQUIPMENT & FEATURES ================= -->
    {{#if equipment.length}}
    <div class="pdf-card mb-3 avoid-break" style="margin-bottom: 14px;">
      <div class="card-header-styled">
        <i class="fa-solid fa-list-check"></i>
        <span>Equipment & Features</span>
      </div>
      <div class="card-body-styled">
        <div class="equipment-grid">
          {{#each equipment}}
          <div class="equipment-item">
            <i class="fa-solid fa-circle-check"></i>
            <span>{{this}}</span>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}

    <!-- ================= VEHICLE DESCRIPTION ================= -->
    {{#if vehicle.description}}
    <div class="pdf-card mb-3 avoid-break" style="margin-bottom: 14px;">
      <div class="card-header-styled">
        <i class="fa-solid fa-align-left"></i>
        <span>Vehicle Description</span>
      </div>
      <div class="card-body-styled">
        <p class="description-text">{{vehicle.description}}</p>
      </div>
    </div>
    {{/if}}

    <!-- ================= MFK & WARRANTY DUAL BOXES ================= -->
    <div class="dual-cards-grid avoid-break">
      <!-- MFK Card -->
      <div class="pdf-card">
        <div class="card-header-styled">
          <i class="fa-solid fa-clipboard-check"></i>
          <span>Motorfahrzeugkontrolle (MFK)</span>
        </div>
        <div class="card-body-styled">
          <div class="info-row">
            <span class="info-label">Last Inspection</span>
            <span class="info-value">{{vehicle.mfk.lastDateDisplay}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Valid Until</span>
            <span class="info-value">{{vehicle.mfk.nextDueDisplay}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Inspection Status</span>
            <span class="info-value">
              <span class="status-pill valid">{{vehicle.mfk.statusLabel}}</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Warranty Card -->
      <div class="pdf-card">
        <div class="card-header-styled">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Warranty & Quality</span>
        </div>
        <div class="card-body-styled">
          <div class="info-row">
            <span class="info-label">Warranty Included</span>
            <span class="info-value">{{warrantyAndReturn.warrantyIncludedText}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Coverage</span>
            <span class="info-value">{{warrantyAndReturn.coverage}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Quality Base</span>
            <span class="info-value">{{warrantyAndReturn.qualityBaseText}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Swiss Car</span>
            <span class="info-value">{{warrantyAndReturn.swissCarText}}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= LEASING SUMMARY ================= -->
    <div class="leasing-card avoid-break">
      <div class="leasing-header">
        <i class="fa-solid fa-calculator"></i>
        <span>Leasing Summary</span>
      </div>
      <div class="leasing-grid">
        <div class="leasing-item">
          <div class="label">Monthly Payment</div>
          <div class="value">{{#if leasing.monthlyPayment}}CHF {{leasing.monthlyPayment}}{{else}}-{{/if}}</div>
        </div>
        <div class="leasing-item">
          <div class="label">Down Payment</div>
          <div class="value">{{#if leasing.downPayment}}CHF {{leasing.downPayment}}{{else}}-{{/if}}</div>
        </div>
        <div class="leasing-item">
          <div class="label">Lease Duration</div>
          <div class="value">{{#if leasing.leaseDurationMonths}}{{leasing.leaseDurationMonths}} months{{else}}-{{/if}}</div>
        </div>
        <div class="leasing-item">
          <div class="label">Km per Year</div>
          <div class="value">{{#if leasing.kmPerYear}}{{leasing.kmPerYear}} km{{else}}-{{/if}}</div>
        </div>
        <div class="leasing-item">
          <div class="label">Interest Rate</div>
          <div class="value">{{#if leasing.interestRate}}{{leasing.interestRate}}%{{else}}-{{/if}}</div>
        </div>
        <div class="leasing-item">
          <div class="label">Residual Value</div>
          <div class="value">{{#if leasing.residualValue}}CHF {{leasing.residualValue}}{{else}}-{{/if}}</div>
        </div>
      </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <div class="pdf-footer">
      <div class="footer-left">
        All information provided is for reference only and subject to change. Please verify all vehicle details and specifications directly with the dealer before making a purchase decision.
      </div>
      <div class="footer-right">
        Generated on {{generatedAt}}
      </div>
    </div>
  </div>
</body>
</html>
